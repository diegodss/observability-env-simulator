# Non-production defaults. compose.yaml already falls back to these values,
# so copying this file to .env is only needed to change something.

# Scheduler / HTTP behaviour of the three AppEvents workers
SYNC_INTERVAL_SECONDS=30
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=1
HTTP_RETRY_BACKOFF_SECONDS=1
SOURCE_STARTUP_WAIT_SECONDS=60

# Service URLs as seen from inside the Docker network (Docker DNS names)
SOURCE_BASE_URL=http://technology-one-sm:8000
TARGET_BASE_URL=http://edw:8000

# Shared development token for write endpoints (Technology One (SM) PATCH, EDW bulk PUT).
# Set to an empty value to disable auth entirely.
API_TOKEN=dev-poc-token

# Database credentials (containers are not exposed to the host)
SOURCE_DB_NAME=technology_one_sm
SOURCE_DB_USER=technology_one_sm
SOURCE_DB_PASSWORD=source-dev-password
TARGET_DB_NAME=edw
TARGET_DB_USER=edw
TARGET_DB_PASSWORD=target-dev-password

# Host ports (bound to 127.0.0.1 only)
SOURCE_HOST_PORT=8001
TARGET_HOST_PORT=8002
APPEVENTS_STUDENT_METRICS_PORT=9101
APPEVENTS_GENERAL_METRICS_PORT=9102
APPEVENTS_CURRICULUM_METRICS_PORT=9103
