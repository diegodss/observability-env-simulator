# Non-production defaults. compose.yaml already falls back to these values,
# so copying this file to .env is only needed to change something.

# Scheduler / HTTP behaviour of the three sync workers
SYNC_INTERVAL_SECONDS=30
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=1
HTTP_RETRY_BACKOFF_SECONDS=1
SIS_STARTUP_WAIT_SECONDS=60

# Service URLs as seen from inside the Docker network (Docker DNS names)
SIS_BASE_URL=http://sis:8000
LMS_BASE_URL=http://lms:8000

# Shared development token for write endpoints (SIS PATCH, LMS bulk PUT).
# Set to an empty value to disable auth entirely.
API_TOKEN=dev-poc-token

# Database credentials (containers are not exposed to the host)
SIS_DB_NAME=sis
SIS_DB_USER=sis
SIS_DB_PASSWORD=sis-dev-password
LMS_DB_NAME=lms
LMS_DB_USER=lms
LMS_DB_PASSWORD=lms-dev-password

# Host ports (bound to 127.0.0.1 only)
SIS_HOST_PORT=8001
LMS_HOST_PORT=8002
SYNC_STUDENTS_METRICS_PORT=9101
SYNC_STAFF_METRICS_PORT=9102
SYNC_COURSES_METRICS_PORT=9103
